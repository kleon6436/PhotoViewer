<UserControl
    x:Class="Kchary.PhotoViewer.Views.ExifInfoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:viewmodel="using:Kchary.PhotoViewer.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance viewmodel:ExifInfoViewModel}"
    d:DesignHeight="500" d:DesignWidth="500">
    <Grid>
        <controls:DataGrid 
            BorderBrush="LightGray" 
            BorderThickness="1"
            FontWeight="Normal" 
            FontSize="14"
            ItemsSource="{x:Bind ExifDataList, Mode=OneWay}" 
            IsReadOnly="True" 
            HeadersVisibility="Column"
            CanUserReorderColumns="False" 
            CanUserResizeColumns="False" 
            CanUserSortColumns="False"
            VerticalScrollBarVisibility="Auto" 
            HorizontalScrollBarVisibility="Disabled" 
            AutoGenerateColumns="False"
            GridLinesVisibility="All">
            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn Header="Parameter" Binding="{Binding ExifParameterText, Mode=OneWay}" Width="Auto" MinWidth="160" />
                <controls:DataGridTextColumn Header="Value" Binding="{Binding ExifParameterValue, Mode=OneWay}" Width="*" MinWidth="100" />
            </controls:DataGrid.Columns>
        </controls:DataGrid>
    </Grid>
</UserControl>