<Window
    x:Class="Kchary.PhotoViewer.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="using:Kchary.PhotoViewer.Views"
    xmlns:viewmodel="using:Kchary.PhotoViewer.ViewModels"
    xmlns:model="using:Kchary.PhotoViewer.Models"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance viewmodel:MainWindowViewModel}"
    Title="PhotoViewer">
    <Grid Background="#F0F0F0">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top toolbar -->
        <Grid Grid.Row="0" Background="LightSkyBlue">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="10,0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontSize="16" Text="Path: " FontWeight="Medium" VerticalAlignment="Center"/>
                <TextBox FontSize="16" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                         Text="{Binding SelectFolderPath.Value, Mode=OneWay}"
                         ToolTip="{Binding SelectFolderPath.Value, Mode=OneWay}" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="5,0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding BluetoothButtonCommand}" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📶" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="Bluetooth"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenFolderButtonCommand}" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="Explorer"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ReloadButtonCommand}" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="Reload"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ImageEditButtonCommand}" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✏️" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="Resize"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SettingButtonCommand}" Margin="2,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙️" FontSize="16" Margin="0,0,5,0"/>
                        <TextBlock Text="Config"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main content area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.3*" MaxWidth="500" />
                <ColumnDefinition Width="0.7*" />
            </Grid.ColumnDefinitions>

            <!-- Left side: Exif and Folder Explorer -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="400" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="1" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Exif" FontSize="16" FontWeight="Medium" Margin="10,5"/>
                        <view:ExifInfoView Grid.Row="1" DataContext="{Binding ExifInfoViewModel, Mode=OneTime}" />
                    </Grid>
                </Border>

                <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Folder" FontSize="16" FontWeight="Medium" Margin="10,5"/>
                        <view:ExplorerView Grid.Row="1" DataContext="{Binding ExplorerViewModel, Mode=OneTime}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Right side: Photo grid and viewer -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="240" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" MinHeight="450" />
                </Grid.RowDefinitions>

                <!-- Photo thumbnail grid using GridView -->
                <GridView Grid.Row="0"
                          x:Name="MediaGridView"
                          ItemsSource="{Binding PhotoFolderLoader.PhotoList, Mode=OneTime}"
                          SelectedItem="{Binding SelectedMedia.Value, Mode=TwoWay}"
                          SelectionMode="Single"
                          Background="#F0F0F0"
                          Padding="10">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="model:PhotoInfo">
                            <Grid Width="100" Height="95">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="75" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Image Grid.Row="0" Source="{x:Bind ThumbnailImage, Mode=OneWay}" Stretch="Uniform"/>
                                <TextBlock Grid.Row="1" Text="{x:Bind FileName, Mode=OneTime}" 
                                           TextTrimming="CharacterEllipsis" 
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- Splitter (simplified as a thin rectangle) -->
                <Rectangle Grid.Row="1" Height="3" Fill="#25A0DA" />

                <!-- Large image viewer -->
                <Image Grid.Row="2" 
                       x:Name="ViewImage" 
                       Source="{Binding PictureImageSource.Value, Mode=OneWay}" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       Margin="10"
                       Stretch="Uniform" />
            </Grid>
        </Grid>
    </Grid>
</Window>
